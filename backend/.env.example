APP_NAME="NexoDB Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Required. Generate a strong random value before any non-local use, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
# Leaving this blank makes every /api/builder/* request fail with 500 (fail-closed).
BUILDER_ADMIN_KEY=change-this-private-key

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexodb
DB_USERNAME=root
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
